# Copy this file to .env.local and fill in real values.
# Until NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are set, the
# app runs entirely on the mock data in lib/mock/ so you can develop the UI
# without a backend.

# --- Supabase (Settings -> API in your project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used by API routes / edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps ---
# Leave blank to fall back to Leaflet + OpenStreetMap automatically.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
